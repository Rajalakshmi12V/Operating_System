// Online C compiler to run C program online#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>
int main()
{
pid_t pid;
pid = fork();
if(pid < 0)
{
printf("Fork Failed\n");
exit(1);
}
else if(pid == 0)
{
printf("\nCHILD PROCESS");
printf("\nChild PID : %d", getpid());
printf("\nParent PID : %d\n", getppid());
exit(0);
}
else
{
wait(NULL);
printf("\nPARENT PROCESS");
printf("\nParent PID : %d", getpid());
printf("\nParent's Parent PID : %d\n", getppid());
}
return 0;
}

